{
  "_comment": "Safety-focused Antigravity CLI settings: strict permissions, terminal sandbox on, plan mode by default, no G1 overflow spend, no non-workspace file access.",

  "agentMode": "plan",
  "toolPermission": "strict",
  "artifactReviewPolicy": "asks-for-review",
  "enableTerminalSandbox": true,
  "allowNonWorkspaceAccess": false,
  "useG1Credits": false,
  "enableTelemetry": false,
  "showTips": true,
  "notifications": true,
  "permissions": {
    "allow": [
      "command(git status)",
      "command(git diff)",
      "command(ls)"
    ]
  },
  "trustedWorkspaces": []
}
