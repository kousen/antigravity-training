{
  "_comment": "Legacy-style MCP server example for migration discussion. Antigravity CLI stores MCP config separately from general settings.",
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "includeTools": [
        "list_repos",
        "get_repo",
        "list_issues"
      ]
    }
  }
}
